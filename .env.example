# ===================================================================
# Splitwise PWA - Environment Configuration Example
# Copy this file to .env and fill in your values
# ===================================================================

# -------------------------------------------------------------------
# Firebase Client Configuration (Web App)
# -------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------------
VITE_APP_NAME="Splitwise PWA"
VITE_DEFAULT_CURRENCY=INR

# Base URL used for generating share links (e.g. https://your-project.web.app or http://localhost:5173)
VITE_APP_URL=

# -------------------------------------------------------------------
# Optional Features & Services
# -------------------------------------------------------------------
VITE_ENABLE_FIREBASE_ANALYTICS=true
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_SUPPORT_EMAIL=
