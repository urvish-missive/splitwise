rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read and write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups: members can read and update; authenticated users can create
    match /groups/{groupId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid in resource.data.memberIds);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Expenses: members of the group can read and create expenses
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Settlements: members can read and write
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null;
    }
  }
}
